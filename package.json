{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:full": "concurrently -k -n WEB,API -c cyan,green \"npm:dev\" \"npm:server:dev\"",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"server/tests/**/*.test.ts\"",
    "check": "npm run lint && npm run server:typecheck && npm test",
    "seed:pos-demo": "tsx server/scripts/seed-pos-demo.ts",
    "seed:floor-demo": "tsx server/scripts/seed-floor-demo.ts",
    "backup": "tsx server/scripts/backup.ts",
    "backup:verify": "tsx server/scripts/verify-backup.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.2",
    "motion": "^12.23.24",
    "nodemailer": "^6.10.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.169.0",
    "ua-parser-js": "^2.0.10",
    "vite": "^8.3.6",
    "xlsx": "^0.18.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.24",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
